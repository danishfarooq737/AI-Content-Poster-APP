# ============================================================
# ViralPost BACKEND - Environment Variables
# Copy this file to "backend/.env" and fill in the values.
# NEVER commit the real backend/.env file.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local MongoDB example: mongodb://127.0.0.1:27017/viralpost
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>/viralpost
MONGODB_URI=mongodb://127.0.0.1:27017/viralpost

# --- Auth secrets ---
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
# Used to encrypt connected-platform OAuth tokens at rest.
# Must be a 64-character hex string (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- AI content generation (Anthropic API) ---
# Get a key at https://console.anthropic.com — used automatically to write
# viral titles/captions/hashtags/tags for every clip produced by Clip Studio.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Vizard.ai (OPTIONAL) - clips a long-form video URL into short viral clips ---
# Get a key at https://vizard.ai. Required for the "Clip Studio" feature.
VIZARD_API_KEY=
VIZARD_API_BASE_URL=https://elb-api.vizard.ai/hvizard-server-front/open-api/v1

# --- TikTok OAuth (Login Kit / Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/api/platforms/tiktok/callback

# --- YouTube / Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/platforms/youtube/callback

# --- Instagram (Meta Graph API) OAuth ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/platforms/instagram/callback

# --- Logging ---
LOG_LEVEL=info
