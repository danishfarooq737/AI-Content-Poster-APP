# ============================================================
# ViralPost FRONTEND - Environment Variables
# Copy this file to "frontend/.env" and fill in the values.
# ============================================================

# Used only by Vite's dev server (`npm run dev`) to proxy /api requests to
# your locally-running backend. Not used in the production build.
VITE_API_PROXY_TARGET=http://localhost:5000

# OPTIONAL: only set this if your frontend is deployed separately from your
# backend (e.g. frontend on Vercel/Netlify, backend on Render/Railway) with
# no reverse proxy in front of both. Point it at your backend's full API URL,
# e.g. https://api.yourdomain.com/api
# Leave blank for local dev and for the Docker Compose setup.
VITE_API_BASE_URL=
